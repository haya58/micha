BOT_ID=my-bot
BOT_DISPLAY_NAME=my-bot
DISCORD_BOT_TOKEN=
# サーバID
DISCORD_GUILD_ID=
DISCORD_CATEGORY_IDS=catid1,catid2
DATABASE_URL=postgres://bot:botpass@localhost:5432/botdb?sslmode=disable
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EXTRA_HEADERS=
# Example for gateways needing extra headers:
# OPENAI_EXTRA_HEADERS=x-opencode-session: ses_xxx
EMBEDDING_DIM=1536
BRAVE_API_KEY=
PERSONA_PATH=
RANDOM_TALK_PROBABILITY=0.02
RANDOM_TALK_COOLDOWN=1800
RESPOND_ALL=false
SHELL_ENABLED=true
SHELL_IMAGE=alpine:latest
SHELL_TIMEOUT=30
HEALTH_ADDR=:8080
